# dependencies
# Ohne Schraegstrich mit Absicht: 'node_modules/' greift nur fuer
# Verzeichnisse. Ein gleichnamiger SYMLINK (Modus 120000) rutscht daran vorbei
# und laesst in der CI 'pnpm install' mit ENOTDIR sterben -- und zwar in jedem
# Job, lange vor dem ersten Test.
node_modules
.pnp
.pnp.*

# next.js
/.next/
/out/
next-env.d.ts

# production
/build
/dist

# testing
/coverage
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# env — secrets never land in the repo
.env
.env.*
!.env.example

# runner state (session ids, locks, logs)
/.runner/

# misc
.DS_Store
*.pem
.vercel
*.tsbuildinfo

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
tests/*.log

# serwist build output
public/sw.js
public/sw.js.map
public/swe-worker-*.js

# Owner session produced by the e2e setup project (#115) — never commit a session.
playwright/.auth/

# agent worktrees — created per session under .claude/worktrees/, never committed.
# Without this the main checkout counts as dirty and the runner refuses to fast-
# forward a PR branch (see pr_catch_up_behind, #171).
.claude/worktrees/
