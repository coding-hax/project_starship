{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "[ -f \"$CLAUDE_PROJECT_DIR/scripts/claude-hooks/pre-bash-guard.mjs\" ] || exit 0; node \"$CLAUDE_PROJECT_DIR/scripts/claude-hooks/pre-bash-guard.mjs\"",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "[ -f \"$CLAUDE_PROJECT_DIR/scripts/claude-hooks/post-edit-checks.sh\" ] || exit 0; bash \"$CLAUDE_PROJECT_DIR/scripts/claude-hooks/post-edit-checks.sh\"",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -f \"$CLAUDE_PROJECT_DIR/scripts/claude-hooks/stop-guard.sh\" ] || exit 0; bash \"$CLAUDE_PROJECT_DIR/scripts/claude-hooks/stop-guard.sh\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
