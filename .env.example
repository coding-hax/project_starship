# Copy to .env.local for development. Never commit a real .env.
# Local Postgres comes from docker-compose.yml.
DATABASE_URL=postgresql://starship:starship@localhost:5432/starship

# Single-user authorisation. Every API route checks the session against this id.
# Generate once with:  node -e "console.log(crypto.randomUUID())"
OWNER_USER_ID=00000000-0000-0000-0000-000000000000

# WebAuthn relying party. RP_ID is the bare hostname (no scheme, no port).
RP_ID=localhost
RP_NAME=Starship
RP_ORIGIN=http://localhost:3000

# Web Push (ADR-0010). Generate once with: npx web-push generate-vapid-keys
# VAPID_PRIVATE_KEY is a secret — never commit the real value.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Garmin-Aktivitäten (ADR-0011). Nur Server, niemals NEXT_PUBLIC_.
# Shared Secret, das der GitHub-Actions-Cron als "Authorization: Bearer …" schickt.
GARMIN_SYNC_SECRET=
# Access-Token des Kartendienstes (Mapbox Static Images) fürs Standbild je Aktivität.
# Fehlt er, zeichnet #180 stattdessen die reine SVG-Spur.
GARMIN_MAP_KEY=
# Tage rückwirkend beim allerersten Sync-Lauf (leere garmin_activities-Tabelle).
# Danach gilt das kleinere Cron-Fenster (7 Tage, im Code). Default 45, falls leer/ungültig.
GARMIN_BACKFILL_DAYS=45
